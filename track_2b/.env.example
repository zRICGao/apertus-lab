# Copy to the ignored .env and fill secrets locally. Starting the UI sends no requests.
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=
WORKBENCH_PROVIDER_PARALLELISM=10
